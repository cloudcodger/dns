-- Knot Resolver configuration
-- Generated by Ansible — do not edit manually

-- Network listeners
{% for listener in knot_resolver_listeners %}
net.listen('{{ listener.addr }}', {{ listener.port }}, { kind = '{{ listener.kind }}' })
{% endfor %}

-- Modules
modules = {
    'hints > iterate',
    'stats',
    'predict',
    'serve_stale < cache',
    'workarounds < iterate',
    'policy',
}

-- Cache
cache.size = {{ knot_resolver_cache_size_mb }} * MB

-- Predictive prefetching
predict.config({ window = 30, period = 96 })

-- RPZ: Allowlist (evaluated FIRST — overrides all blocks)
policy.add(
    policy.rpz(policy.PASS,
               '{{ knot_resolver_rpz_dir }}/{{ knot_resolver_rpz_allowlist_name }}.rpz',
               true))

-- RPZ: Blocklists
{% for bl in knot_resolver_rpz_blocklists %}
policy.add(
    policy.rpz(policy.{{ bl.policy }},
               '{{ knot_resolver_rpz_dir }}/{{ bl.name }}.rpz',
               true))
{% endfor %}

-- Stub internal domains to Knot DNS
local internal = policy.todnames({ {% for d in knot_resolver_internal_domains %}'{{ d }}'{% if not loop.last %}, {% endif %}{% endfor %} })
policy.add(policy.suffix(policy.STUB({ {% for s in knot_resolver_stub_servers %}'{{ s }}'{% if not loop.last %}, {% endif %}{% endfor %} }), internal))

-- Log policy decisions
log_groups({'policy'})
