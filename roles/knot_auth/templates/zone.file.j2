{# This file uses tabs because dynamicly updated zone files contain them. #}
;
; Dynamically generated by Ansible on {{ inventory_hostname }}
;
; Local modifications will be overwritten by Ansible.
;
$TTL {{ knot_auth_zone_default_ttl }}
@			IN SOA	{{ knot_auth_loop_zone.mname | default(knot_auth_soa_zone_mname) }} {{ knot_auth_loop_zone.email | default(knot_auth_soa_email_address) }} (
{% if not (knot_auth_zone_comparator_file | default(false)) %}
				{{ ansible_facts['date_time']['epoch'] }} ; serial
{% endif %}
				{{ knot_auth_loop_zone.refresh | default(knot_auth_zone_default_refresh) }} ; refresh
				{{ knot_auth_loop_zone.retry | default(knot_auth_zone_default_retry) }} ; retry
				{{ knot_auth_loop_zone.expire | default(knot_auth_zone_default_expire) }} ; expire
				{{ knot_auth_loop_zone.negative_cache_ttl | default(knot_auth_zone_default_negative_cache_ttl) }} ; minimum
				)

{# Create NS records for the name servers. #}
{% for ns in knot_auth_loop_zone.ns | default(ansible_facts['play_batch'] | sort) %}
			NS	{{ ns }}{{ ('.' + knot_auth_base_domain + '.') if not ns is search("\.") }}
{% endfor %}

{# Create all records from the resource records variable for the knot_auth_loop_zone. #}
{% if lookup('ansible.builtin.vars', knot_auth_zone_records_var) is defined %}
{%   for rr in lookup('ansible.builtin.vars', knot_auth_zone_records_var) %}
{%     set line=rr.split(';') %}
{#          line[0] = label #}
{#          line[1] = TTL #}
{#          line[2] = type #}
{#          line[3] = rdata #}
{%     set nl=line[0] | length %}
{%     if line[2] is defined %}
{{ line[0] }}{{ "\t" if nl < 16 }}{{ "\t" if nl < 8 }}{{ line[1] }}	{{ line[2] }}	{{ line[3] }}
{%     else %}

{%     endif %}
{%   endfor %}
{% endif %}
