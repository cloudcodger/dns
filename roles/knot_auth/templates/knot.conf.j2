# Dynamically generated by Ansible on {{ inventory_hostname }}
#
# Local modifications will be overwritten by Ansible.
#
server:
  identity: "{{ knot_auth_identity }}"
  user: "knot:knot"
{% for addr in knot_auth_listen %}
  listen: "{{ addr }}"
{% endfor %}

acl:
{% for acl in knot_auth_acl %}
  - id: "{{ acl.id | default(loop.index | string) }}"
    address: "{{ acl.address }}"
    action: {{ acl.action | default('transfer') }}
{% endfor %}

log:
  - target: syslog
    any: info

template:
  - id: default
    storage: "{{ knot_auth_storage }}"
    file: "%s.zone"

zone:
{% for zone in knot_auth_zones %}
  - domain: "{{ zone.domain }}"
    template: default
    dnssec-signing: {{ 'on' if zone.dnssec_signing | default(true) else 'off' }}
    journal-content: changes
    zonefile-load: whole
    zonefile-sync: -1
{% endfor %}
